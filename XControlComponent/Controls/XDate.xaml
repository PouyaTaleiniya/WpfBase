<UserControl x:Class="XControlComponents.Controls.XDate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:XControlComponents.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:fa5="http://schemas.fontawesome.com/icons/"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/XControlComponents;component/XControlComponentResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:CharCountWithMaxConverter x:Key="CharCountWithMaxConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
 
    <Grid Height="27" Name="GR_DateBox" Focusable="True" FocusVisualStyle="{x:Null}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.02*"/>
            <ColumnDefinition Width="140" Name="GR_Col_Lable"/>
            <ColumnDefinition />
            <ColumnDefinition Width="0.02*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0" Name="GR_Row_Label"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid Grid.Column="1" Grid.Row="1" Name="GR_Content">
            <StackPanel Orientation="Horizontal">
                <Label Name="Lb_Content"  Padding="10 0 0 0" VerticalAlignment="Center" FontSize="13.9"/>
                <Label Name="Lb_Required" Content="*" Padding="5 0 0 0" VerticalAlignment="Center" Foreground="#de0030" FontSize="16" Visibility="Hidden"/>
            </StackPanel>
        </Grid>
        <Border Name="BR_Date" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="1" Style="{StaticResource BorderInput}" Background="White" BorderThickness="1">
            <Grid>
                <Grid Visibility="Hidden">
                    <DatePicker
                     Visibility="Hidden" 
                     Name="DT_Date"
                     Padding="5 0 5 0"   
                     VerticalAlignment="Center" 
                     SelectedDateFormat="Short"
                     BorderThickness="0" 
                     materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                     Style="{StaticResource MaterialDesignDatePicker}"
                     CalendarOpened="DatePicker_CalendarOpened"
                     CalendarClosed="DatePicker_CalendarClosed"
                   >
                        <materialDesign:HintAssist.Hint>
                            <Label Name="Lb_PlaceHolder1" Content="تاریخ انتخاب کنید" Padding="0" />
                        </materialDesign:HintAssist.Hint>
                    </DatePicker>
                </Grid>
                <Grid Visibility="Visible">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition  Width="0.02*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Visibility="Visible"
                        Grid.Column="0" 
                        Name="Txt_Data"  
                        BorderThickness="0" 
                        Cursor="IBeam"
                        MaxLines="3"
                        materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                        Padding="5 3 5 0" 
                        materialDesign:TextFieldAssist.CharacterCounterVisibility="Hidden"
                        PreviewTextInput="Txt_Data_PreviewTextInput"
                        PreviewKeyDown="Txt_Data_PreviewKeyDown"
                        DataObject.Pasting="Txt_Data_Pasting"
                        GotFocus="Txt_Data_GotFocus"
                        LostFocus="Txt_Data_LostFocus">
                        <materialDesign:HintAssist.Hint>
                            <Label Name="Lb_PlaceHolder" Padding="0" />
                        </materialDesign:HintAssist.Hint>
                    </TextBox>
                    <xctk:DateTimePicker 
                             Grid.Column="0" 
                             Grid.ColumnSpan="3"
                             x:Name="MyDatePicker"
                             Format="ShortDate"
                             FormatString="yyyy/MM/dd"
                             Value="{x:Static sys:DateTime.Now}"
                             TimePickerVisibility="Visible"
                             BorderBrush="Transparent"   
                             Foreground="Black"
                             Background="White"
                             AutoCloseCalendar="True"
                         Visibility="Hidden"
                             >
                        <xctk:DateTimePicker.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Orange"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                        </xctk:DateTimePicker.Resources>
                    </xctk:DateTimePicker>
                    <Label  VerticalAlignment="Center" Visibility="Visible" Grid.Column="1" Background="Transparent" BorderThickness="0" Cursor="Hand" MouseLeftButtonDown="Label_MouseLeftButtonDown">
                             <materialDesign:PackIcon Kind="CalendarDay"
                             Width="18" Height="20"
                             Foreground="#6b6b6b"/>
                        
                    </Label>
                    <materialDesign:DialogHost x:Name="DateDialogHost"  DialogMargin="1" DialogBackground="{StaticResource Color_White_f3f3f3}"  BorderThickness="1"  BorderBrush="Transparent" OverlayBackground="Transparent" >
                        <materialDesign:DialogHost.DialogContent>
                            <Calendar IsTodayHighlighted="True" x:Name="MyCalendar" SelectedDatesChanged="MyCalendar_SelectedDatesChanged" SelectionMode="SingleDate" 
                                      materialDesign:CalendarAssist.HeaderBackground ="MediumVioletRed"
                                      materialDesign:CalendarAssist.HeaderForeground ="White"
                                      materialDesign:CalendarAssist.IsHeaderVisible ="True"
                                      CalendarDayButtonStyle="{StaticResource MaterialDesignCalendarDayButton}"
                                      >
                                <!--<Calendar.Resources> 
                                    <ResourceDictionary>
                                        <ResourceDictionary.MergedDictionaries>
                                            <StaticResource ResourceKey="CustomCalendarTheme"/>
                                        </ResourceDictionary.MergedDictionaries>
                                    </ResourceDictionary>
                                </Calendar.Resources>-->
                            </Calendar>
                        </materialDesign:DialogHost.DialogContent> 
                    </materialDesign:DialogHost>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
