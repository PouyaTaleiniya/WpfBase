<ResourceDictionary  
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">


    <ResourceDictionary.MergedDictionaries>
        <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Lime" />
 

        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
 

    </ResourceDictionary.MergedDictionaries>

    <materialDesign:BundledTheme x:Key="CustomCalendarTheme" 
                BaseTheme="Light"
                PrimaryColor="DeepPurple" 
                SecondaryColor="Lime" />

    <!--Colors (Each Color Add To XAppMethod.cs) -->
    <SolidColorBrush x:Key="Color_Red_c42b1c" Color="#c42b1c" /> 
    <SolidColorBrush x:Key="Color_Red_de0030" Color="#de0030" />
    <SolidColorBrush x:Key="Color_Red_FFE6E6" Color="#FFE6E6" />
    <SolidColorBrush x:Key="Color_White_f3f3f3" Color="#f3f3f3" />
    <SolidColorBrush x:Key="Color_White_f8f9ff" Color="#f8f9ff" />
    <SolidColorBrush x:Key="Color_Gray_949494" Color="#949494" />
    <SolidColorBrush x:Key="Color_Gray_959595" Color="#959595" />
    <SolidColorBrush x:Key="Color_Gray_d9d9d9" Color="#d9d9d9" />
    <SolidColorBrush x:Key="Color_Gray_D1D1D1" Color="#D1D1D1" />
    <SolidColorBrush x:Key="Color_Gray_B8B8B8" Color="#B8B8B8" />
    <SolidColorBrush x:Key="Color_Blue_cbdeec" Color="#cbdeec" />
    <SolidColorBrush x:Key="Color_Blue_4a78b0" Color="#4a78b0" />
    <SolidColorBrush x:Key="Color_Blue_0D47A1" Color="#1565C0" />
    <SolidColorBrush x:Key="Color_Blue_2196f3" Color="#2196f3" />
    <SolidColorBrush x:Key="Color_Black_424242" Color="#424242" />
    <SolidColorBrush x:Key="Color_Black_212121" Color="#212121" />
    <SolidColorBrush x:Key="Color_Black_1E1E1E" Color="#1E1E1E" />
    <SolidColorBrush x:Key="Color_Black_444040" Color="#444040" />
    
    <Style x:Key="LabelTemplate" TargetType="{x:Type Label}">
        <Setter Property="Foreground" Value="{StaticResource Color_Black_1E1E1E}" />
        <Setter Property="FontSize" Value="20" />
    </Style>

    <Style x:Key="BorderWindow" TargetType="{x:Type Border}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Background" Value="{StaticResource Color_White_f3f3f3}" />
        <Setter Property="BorderBrush" Value="{StaticResource Color_Gray_949494}" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="BorderInput" TargetType="{x:Type Border}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="BorderBrush" Value="{StaticResource Color_Gray_959595}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="BorderGrid" TargetType="{x:Type Border}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="BorderInnerGrid" TargetType="{x:Type Border}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="BorderDevice" TargetType="{x:Type Border}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="BorderHeader" TargetType="{x:Type Border}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Background" Value="{StaticResource Color_Blue_cbdeec}" />
        <Setter Property="BorderBrush" Value="{StaticResource Color_Gray_949494}" />
        <Setter Property="BorderThickness" Value="0 0 0 1" />
        <Setter Property="CornerRadius" Value="5 5 0 0" />
    </Style>

    <Style x:Key="NameTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
        <Setter Property="materialDesign:HintAssist.HintOpacity" Value="0.35"/>
        <Setter Property="materialDesign:ColorZoneAssist.Mode" Value="Dark"/>
        <Setter Property="materialDesign:HintAssist.HintOpacity" Value="0.35"/>
        <Setter Property="materialDesign:HintAssist.FontFamily" Value="Century Gothic"/>
        <Setter Property="Foreground" Value="AliceBlue"/>
        <Setter Property="FontSize" Value="20"/>
    </Style>

   

</ResourceDictionary>